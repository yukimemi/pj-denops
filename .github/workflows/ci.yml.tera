{#- Resolve action pins from .kata/vars.toml. pj-base seeds
    `actions.checkout`; pj-denops seeds `actions.deno_setup`. -#}
# kata-managed — source: yukimemi/pj-denops/.github/workflows/ci.yml.tera
# Local edits are reverted on the next `kata apply`. Push fixes upstream.
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  ci:
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    steps:
      - uses: actions/checkout@{{ vars.actions.checkout }}

      - uses: denoland/setup-deno@{{ vars.actions.deno_setup }}

      - name: Run CI
        shell: bash
        run: deno task ci
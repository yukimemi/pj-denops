{#- Resolve pins from `.kata/vars.toml`. pj-base seeds `actions.checkout`;
    pj-denops seeds the rest.

    Every denops-layer lookup is guarded with `is defined` + `set_global`
    rather than a `default(...)` filter: kata's Tera render is strict, so an
    undefined variable aborts `kata apply` for every existing consumer whose
    `.kata/vars.toml` predates a key. Tera also cannot express an empty-map
    fallback (`default(value={})` is a parse error), so the intermediate
    `vars.denops` table has to be probed with `is defined` too. `set_global`
    because a plain `set` inside an `if` would not escape the block.

    GitHub Actions expressions share Tera's `{{ }}` delimiters, so every
    `${{ … }}` below is wrapped in `{% raw %}` to survive rendering. -#}
{%- set act = vars.actions -%}
{%- set_global vim_setup = "v1" -%}
{%- set_global vim_setup_thinca = "v3" -%}
{%- set_global vim_version = "v9.2.0148" -%}
{%- set_global nvim_version = "v0.12.4" -%}
{%- if act.rhysd_action_setup_vim is defined -%}
{%- set_global vim_setup = act.rhysd_action_setup_vim -%}
{%- endif -%}
{%- if act.thinca_action_setup_vim is defined -%}
{%- set_global vim_setup_thinca = act.thinca_action_setup_vim -%}
{%- endif -%}
{%- if vars.denops is defined and vars.denops.vim_version is defined -%}
{%- set_global vim_version = vars.denops.vim_version -%}
{%- endif -%}
{%- if vars.denops is defined and vars.denops.nvim_version is defined -%}
{%- set_global nvim_version = vars.denops.nvim_version -%}
{%- endif -%}
# kata-managed — source: yukimemi/pj-denops/.github/workflows/ci.yml.tera
# Local edits are reverted on the next `kata apply`. Push fixes upstream.
name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  ci:
    name: {% raw %}ci (${{ matrix.os }}){% endraw %}
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: {% raw %}${{ matrix.os }}{% endraw %}
    steps:
      - uses: actions/checkout@{{ act.checkout }}

      # Vim. rhysd/action-setup-vim builds from source, which only works
      # on Linux runners here; thinca/action-setup-vim installs a prebuilt
      # Vim on macOS / Windows. Both expose the same `executable` output,
      # coalesced into DENOPS_TEST_VIM_EXECUTABLE below.
      - uses: rhysd/action-setup-vim@{{ vim_setup }}
        if: {% raw %}matrix.os == 'ubuntu-latest'{% endraw %}
        id: vim-rhysd
        with:
          version: "{{ vim_version }}"

      - uses: thinca/action-setup-vim@{{ vim_setup_thinca }}
        if: {% raw %}matrix.os != 'ubuntu-latest'{% endraw %}
        id: vim-thinca
        with:
          vim_type: "Vim"
          vim_version: "{{ vim_version }}"

      - uses: rhysd/action-setup-vim@{{ vim_setup }}
        id: nvim
        with:
          neovim: true
          version: "{{ nvim_version }}"

      - uses: denoland/setup-deno@{{ act.deno_setup }}

      # `@denops/test` spawns these binaries directly; without the two
      # env vars every `test({ mode: "vim" | "nvim" })` case fails.
      - name: Run CI
        shell: bash
        run: deno task ci
        env:
          DENOPS_TEST_VIM_EXECUTABLE: {% raw %}${{ steps.vim-rhysd.outputs.executable || steps.vim-thinca.outputs.executable }}{% endraw %}
          DENOPS_TEST_NVIM_EXECUTABLE: {% raw %}${{ steps.nvim.outputs.executable }}{% endraw %}